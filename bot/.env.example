DISCORD_BOT_TOKEN=your_discord_bot_token
SUPABASE_URL=https://ewsvttrxcqxgifiajvkt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Bot role ──────────────────────────────────────────────────────────────
# production → processes every user (no filter) — this is the normal bot
# test       → processes ONLY admins (profiles.is_admin=true). Meant to be
#              started temporarily while you verify a change; stopped when
#              done. When both prod + test are running, admins deliberately
#              get two notifications per match (one from each Discord
#              token). When only prod runs, admins behave like any other
#              user. Real (non-admin) users are NEVER touched by the test
#              bot, which is the whole point of the split.
BOT_ROLE=production

# ── Auto-updater ──────────────────────────────────────────────────────────
# Branch on carryligi/eventry-dash the updater pulls from on start.
# Production: main. Test: Develope (to test changes before merging to main).
BOT_UPDATE_BRANCH=main

# Set to false to disable the updater entirely — useful if you're iterating
# on files inside the bot folder and don't want them overwritten on restart.
BOT_AUTO_UPDATE=true
